# Supabase do Info In Time (o mesmo do .env do n8n: SUPABASE_HOST / SUPABASE_SERVICE_KEY)
SUPABASE_URL=https://smellinggreenlandshark-supabase.cloudfy.live
SUPABASE_SERVICE_KEY=coloque-a-service-key-aqui

# Login unico do /admin (voce e a loja usam o mesmo)
ADMIN_USER=infointime
ADMIN_PASSWORD=troque-esta-senha
# Qualquer texto longo e aleatorio (assina o cookie de sessao)
ADMIN_SECRET=gere-um-texto-aleatorio-com-40-caracteres-ou-mais

# Endereco publico do site (usado em links de compartilhamento)
NEXT_PUBLIC_SITE_URL=https://infointime.com.br
